# MCP Gateway configuration (copy to .env)

# --- Server ---------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_LOG_LEVEL=info

# --- Data -----------------------------------------------------------------
MCP_DATA_DIR=./data
# MCP_DB_PATH=./data/gateway.db
# MCP_REPOS_DIR=./data/repos
# MCP_UI_DIST=./ui/dist

# --- Bootstrap key --------------------------------------------------------
# Created once, only when the api_keys table is empty. Generate with:
#   openssl rand -base64 32
MCP_MASTER_KEY=

# --- Secret vault (required for vault features) ---------------------------
# 32+ random characters. Derives the AES-256-GCM key via scrypt.
#   openssl rand -base64 48
MCP_VAULT_SECRET=

# --- Key hashing ----------------------------------------------------------
# Optional pepper mixed into API-key SHA-256 hashes. Rotating it invalidates
# every issued key, so keep it stable.
MCP_KEY_PEPPER=

# --- Delegation / observer pattern ---------------------------------------
MCP_DELEGATION_MAX_DEPTH=3

# --- Git import engine ----------------------------------------------------
# Comma-separated clone URL allowlist. Example:
#   MCP_GIT_IMPORT_ALLOWED_PREFIXES=https://github.com/,https://gitlab.com/
MCP_GIT_IMPORT_ALLOWED_PREFIXES=
# MCP_ENABLE_GIT_IMPORT=true

# --- Limits ---------------------------------------------------------------
MCP_TOOL_TIMEOUT_MS=60000
MCP_BODY_LIMIT_BYTES=1048576
