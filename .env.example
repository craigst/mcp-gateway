# MCP Gateway configuration (copy to .env)

# --- Server ---------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_LOG_LEVEL=info

# --- Data -----------------------------------------------------------------
MCP_DATA_DIR=./data
# MCP_DB_PATH=./data/gateway.db
# MCP_REPOS_DIR=./data/repos
# MCP_UI_DIST=./ui/dist

# --- Bootstrap key --------------------------------------------------------
# Created once, only when the api_keys table is empty. Generate with:
#   openssl rand -base64 32
MCP_MASTER_KEY=

# --- Secret vault (required for vault features) ---------------------------
# 32+ random characters. Derives the AES-256-GCM key via scrypt.
#   openssl rand -base64 48
MCP_VAULT_SECRET=

# --- Key hashing ----------------------------------------------------------
# Optional pepper mixed into API-key SHA-256 hashes. Rotating it invalidates
# every issued key, so keep it stable.
MCP_KEY_PEPPER=

# --- Delegation / observer pattern ---------------------------------------
MCP_DELEGATION_MAX_DEPTH=3

# --- Git import engine ----------------------------------------------------
# Comma-separated clone URL allowlist. Example:
#   MCP_GIT_IMPORT_ALLOWED_PREFIXES=https://github.com/,https://gitlab.com/
MCP_GIT_IMPORT_ALLOWED_PREFIXES=
# MCP_ENABLE_GIT_IMPORT=true

# --- Limits ---------------------------------------------------------------
MCP_TOOL_TIMEOUT_MS=60000
# Comma-separated sub-server names to start with the gateway, or 'all'.
MCP_AUTOSTART=
MCP_BODY_LIMIT_BYTES=1048576


# --- v0.2 plugin catalog / private GitHub import --------------------------
# Fallback token for private repos when a catalog source has no vault token.
# A source-specific token added in the UI is stored encrypted in the vault.
GITHUB_TOKEN=
# GH_TOKEN=

# --- v0.2 local harness discovery -----------------------------------------
# Optional path overrides (defaults point at each harness's standard config):
# MCP_DISCOVERY_CLAUDE_CONFIG=~/.claude.json
# MCP_DISCOVERY_OPENCODE_CONFIG=~/.config/opencode/opencode.json
# MCP_DISCOVERY_OPENMAUSBOT_CONFIG=~/.openmausbot/config.json
# MCP_DISCOVERY_CONFIG=/path/to/generic-mcp.json


# --- v0.9 computer use (Computer Broker) ----------------------------------
# The gateway fronts a self-hosted Computer Broker as the managed `computer-use`
# MCP server. It stays disabled until a broker URL and a token are configured;
# MCP_COMPUTER_USE_ENABLED=false disables the integration entirely.
MCP_COMPUTER_USE_ENABLED=true
# Server-side broker base URL, e.g. https://127.0.0.1:7443
MCP_COMPUTER_BROKER_URL=
# Browser-facing broker base URL for "open live desktop" links. Defaults to
# MCP_COMPUTER_BROKER_URL when unset (e.g. https://broker.example.com).
MCP_COMPUTER_BROKER_PUBLIC_URL=
# Optional bootstrap bearer token for the broker agent API. Takes precedence
# over a vault token. Preferred: save the token in the console (Computer Use ->
# Settings) so it is stored in the encrypted vault instead of a plaintext
# environment variable.
MCP_COMPUTER_BROKER_TOKEN=
# Optional PEM CA bundle path for a mkcert / self-signed broker certificate.
# In Docker, mount the file read-only and use the container path, e.g.
#   - ./certs/broker-ca.pem:/certs/broker-ca.pem:ro
# with MCP_COMPUTER_BROKER_CA=/certs/broker-ca.pem
MCP_COMPUTER_BROKER_CA=


# --- Web UI login (browser console) ---------------------------------------
# API keys remain for AI / external clients. The console uses a session cookie.
MCP_UI_USERNAME=admin
# Optional. If empty on a fresh install, the gateway starts in SETUP MODE and
# the first-run wizard creates the operator account in the Web UI. Set it to
# pre-create a known account (>=8 chars) and skip the wizard.
MCP_UI_PASSWORD=
# Session lifetime (default 12h) and Secure cookie when behind HTTPS.
MCP_UI_SESSION_TTL_MS=43200000
MCP_UI_COOKIE_SECURE=false
