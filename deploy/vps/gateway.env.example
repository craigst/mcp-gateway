# Copy to /opt/mcp-gateway/gateway.env, chmod 600, fill every empty value.
# The gateway is reachable only over WireGuard and the OMB Docker network.
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_DATA_DIR=/data
MCP_LOG_LEVEL=info
MCP_AUTOSTART=all
MCP_DELEGATION_MAX_DEPTH=3
MCP_GIT_IMPORT_ALLOWED_PREFIXES=https://github.com/
MCP_TOOL_TIMEOUT_MS=120000
MCP_UI_USERNAME=admin
MCP_UI_PASSWORD=
MCP_UI_SESSION_TTL_MS=43200000
MCP_UI_COOKIE_SECURE=false
MCP_KEY_PEPPER=
MCP_MASTER_KEY=
MCP_VAULT_SECRET=

# Computer Broker now runs ON THIS VPS (moved off gpc 2026-11-05), so
# computer-use no longer depends on any home machine being awake.
# Reached over WireGuard at 10.10.1.4:7443 (the broker binds that address;
# UFW only admits 10.10.0.0/16 and the Docker subnets). The mkcert cert SANs
# include 10.10.1.4, so the IP needs no DNS and no extra_hosts.
# URL, PUBLIC_URL and INSTALL_BASE_URL must all agree.
#   broker service: /etc/systemd/system/computer-broker.service
#   broker code:    /opt/computer-broker  (venv in ./venv)
#   broker state:   /home/craigst/.local/share/computer-broker
MCP_COMPUTER_USE_ENABLED=true
MCP_COMPUTER_BROKER_URL=https://10.10.1.4:7443
MCP_COMPUTER_BROKER_PUBLIC_URL=https://10.10.1.4:7443
MCP_COMPUTER_INSTALL_BASE_URL=https://10.10.1.4:7443
MCP_COMPUTER_BROKER_CA=/certs/broker-ca.pem
MCP_COMPUTER_BROKER_TOKEN=
# OMB automation calls device_exec; only destroying a computer keeps a ticket.
MCP_COMPUTER_APPROVAL_REQUIRED_TOOLS=destroy_computer

# Broker CA + DeviceBridge CA, concatenated. The container runs as uid 1000:
# certs/ must be 755 and the PEMs 644 or Node fails to load this file.
NODE_EXTRA_CA_CERTS=/certs/combined-ca.pem

# TypeSafe Jev decision model, used by email triage to judge incoming mail.
# The same key OMB holds as `decider.key`; it is a `apik…` bearer for
# https://api.typesafe.ai/v1/systemone. Leave it empty to keep triage inert:
# the watcher refuses to judge rather than guessing, and mail is left alone.
JEV_API_KEY=
